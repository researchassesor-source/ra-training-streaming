NODE_ENV=development
APP_ENV=development
APP_DISPLAY_ENV=Desarrollo
APP_NAME=R.A. Training Streaming
APP_PUBLIC_URL=http://localhost:3000
APP_VERSION=development
APP_TIME_ZONE=America/Guayaquil
APP_TIME_ZONE_LABEL=Ecuador continental
PREVIEW_ISOLATION_ACK=false
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
INVITATION_HASH_SECRET=replace-with-an-independent-32-byte-secret
SESSION_TTL_HOURS=12
ROOM_SESSION_TTL_HOURS=8
ADMIN_USERNAME=admin-local
ADMIN_PASSWORD=replace-with-a-long-local-password
COOKIE_SECURE=false
ALLOW_OPEN_DEV_ROOMS=false
INVITATION_TOKEN_TTL_MINUTES=1440
LOGIN_RATE_LIMIT_WINDOW=900
LOGIN_RATE_LIMIT_MAX=8
CHAT_RATE_LIMIT_MAX=20
MEETING_RATE_LIMIT_MAX=20
TRANSCRIPTION_RATE_LIMIT_MAX=10
MAX_JSON_PAYLOAD=256kb
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_CHAT_FILE_SIZE=10485760
ALLOWED_CHAT_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain

# LiveKit local. No uses credenciales productivas en desarrollo.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://localhost:7880

# Déjalas vacías para usar persistencia JSON local y deshabilitar grabaciones.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=auto
RECORDING_S3_ENDPOINT=

# Transcripción desactivada por defecto. "mock" solo se admite para desarrollo y pruebas.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_LANGUAGE=es
TRANSCRIPTION_MAX_DURATION_MINUTES=240
TRANSCRIPTION_RETENTION_DAYS=90
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_ALLOWED_HOSTS=
