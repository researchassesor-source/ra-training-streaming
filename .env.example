# LiveKit Cloud project credentials (Settings > Keys in cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# S3-compatible bucket where session recordings (Egress output) are uploaded.
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, etc.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=us-east-1
# Only needed for non-AWS S3-compatible endpoints (R2, Spaces, MinIO)
RECORDING_S3_ENDPOINT=

PORT=3000
